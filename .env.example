# Copy to .env and fill in. Never commit .env.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000
DATABASE_URL=postgres://ssb:ssb_password@localhost:5432/ssb
# Production: use Redis so rate limits are shared across workers
CACHE_URL=locmemcache://
MEDIA_ROOT=
PRIVATE_MEDIA_ROOT=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_NOTIFICATIONS_ENABLED=True
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_NOTIFICATIONS_ENABLED=True
DEFAULT_FROM_EMAIL=SSB Group <no-reply@ssbgroup.uz>
# Production only
DJANGO_BEHIND_PROXY=False
DJANGO_SECURE_SSL_REDIRECT=True
LOG_LEVEL=INFO

# Enterprise services (server-side only; never bundle .env into Electron)
ARCHIVE_MAX_MB=50
ARCHIVE_UNPACKED_MAX_MB=500
MALWARE_SCANNER=
# Set True in production; uploads fail closed when no scanner is configured.
REQUIRE_MALWARE_SCAN=True
PERFORMANCE_AI_ENDPOINT=
PERFORMANCE_AI_KEY=
# Haftalik baholash AI (Claude). Kalitni https://console.anthropic.com dan oling.
ANTHROPIC_API_KEY=
PERFORMANCE_AI_MODEL=claude-opus-5-5
# Optional absolute path to an actual generated Windows installer.
# DESKTOP_RELEASE_PATH=C:/releases/SSB-Boshqaruv-Setup-1.0.1.exe
# Telegram bot asosiy adminlari (Telegram ID, vergul bilan). ID ni bilish: botga /id yozing.
TELEGRAM_ADMIN_IDS=
